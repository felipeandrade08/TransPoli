<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="#0A1723"/><Setter Property="BorderBrush" Value="#1C3A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
    <Style x:Key="MiniCard" TargetType="Border"><Setter Property="Background" Value="#07131E"/><Setter Property="BorderBrush" Value="#1C3A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
    <Style x:Key="StatCard" TargetType="Border"><Setter Property="Background" Value="#0A1723"/><Setter Property="BorderBrush" Value="#1C3A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
    <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="Background" Value="#0B1B27"/><Setter Property="BorderBrush" Value="#B88900"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="#1C3A50"/><Setter Property="FontSize" Value="15"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#B8C5CF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Foreground" Value="#FFC400"/><Setter Property="Background" Value="#211A05"/><Setter Property="BorderBrush" Value="#B88900"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter Margin="12,0" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
