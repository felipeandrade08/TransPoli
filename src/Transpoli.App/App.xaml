<Application x:Class="Transpoli.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <SolidColorBrush x:Key="BgBrush" Color="#06101A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0A1723" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#0D1E2D" />
        <SolidColorBrush x:Key="GoldBrush" Color="#FFC400" />
        <SolidColorBrush x:Key="GoldDimBrush" Color="#8A6900" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA1B2" />
        <SolidColorBrush x:Key="GreenBrush" Color="#27E06F" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF4D5F" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
