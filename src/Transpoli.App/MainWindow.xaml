<Window x:Class="Transpoli.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="CanResize" Background="#06101A" MinWidth="1100" MinHeight="680"
        Title="Transpoli - Computador de Bordo">
    <Border BorderBrush="#243747" BorderThickness="1" CornerRadius="12" Background="#06101A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#07131E" BorderBrush="#182A38" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="25" Background="#07111D" BorderBrush="#FFC400" BorderThickness="2">
                            <TextBlock Text="TP" Foreground="#FFC400" FontWeight="Black" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TRANSPOLI" FontSize="25" FontWeight="Black"/>
                            <TextBlock Text="COMPUTADOR DE BORDO" Foreground="#FFC400" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#0A1B26" BorderBrush="#24506A" BorderThickness="1" CornerRadius="18" Padding="14,7" Margin="8,0">
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#F04444" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="AGUARDANDO ETS2" FontSize="11" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#1B1708" BorderBrush="#8A6900" BorderThickness="1" CornerRadius="18" Padding="14,7" Margin="8,0">
                            <TextBlock x:Name="TelemetryStatusText" Text="ETS2 • AGUARDANDO" Foreground="#FFC400" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="--:--" Foreground="#A9B7C4" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button x:Name="UpdateButton" Content="↻  ATUALIZAR" Click="UpdateButton_Click" Style="{StaticResource ActionButton}"/>
                        <Button Content="—" Click="Minimize_Click" Style="{StaticResource WindowButton}"/>
                        <Button Content="□" Click="Maximize_Click" Style="{StaticResource WindowButton}"/>
                        <Button Content="×" Click="Close_Click" Style="{StaticResource WindowButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#07131E" BorderBrush="#182A38" BorderThickness="0,0,1,0" Padding="14,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                            <Border Background="#0A1723" BorderBrush="#806400" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TRANSPOLI" Foreground="#FFC400" FontWeight="Bold"/>
                                    <TextBlock Text="v0.1.0" Foreground="#8FA1B2" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="Desenvolvido por Felipe Andrade" Foreground="#637788" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NAVEGAÇÃO" Foreground="#5F7688" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                            <Button Content="⌂   INÍCIO" Style="{StaticResource NavButtonActive}"/>
                            <Button Content="⌁   VIAGEM" Style="{StaticResource NavButton}"/>
                            <Button Content="◷   TACÓGRAFO" Style="{StaticResource NavButton}"/>
                            <Button Content="▣   CARGA" Style="{StaticResource NavButton}"/>
                            <Button Content="⛽   COMBUSTÍVEL" Style="{StaticResource NavButton}"/>
                            <Button Content="¤   MEU BANCO" Style="{StaticResource NavButton}"/>
                            <Button Content="⚒   MANUTENÇÃO" Style="{StaticResource NavButton}"/>
                            <Button Content="▥   ESTATÍSTICAS" Style="{StaticResource NavButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,9,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="▸  VEÍCULO" Foreground="#FFC400" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock x:Name="TruckNameText" Text="Aguardando ETS2" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="TelemetryHintText" Text="Conecte o ETS2 para receber telemetria." Foreground="#8FA1B2" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="TripButton" Content="INICIAR VIAGEM" Click="TripButton_Click" Style="{StaticResource ActionButton}" Padding="14,7"/><TextBlock x:Name="TripStatusText" Text="  Nenhuma viagem ativa" Foreground="#8FA1B2" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"/></StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10212D" BorderBrush="#24506A" BorderThickness="1" CornerRadius="18" Padding="12,6">
                                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="EngineDot" Width="9" Height="9" Fill="#F04444" Margin="0,0,8,0"/><TextBlock x:Name="EngineText" Text="MOTOR • DESLIGADO" FontSize="10" FontWeight="Bold"/></StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48,0,0">
                                        <TextBlock x:Name="SpeedText" Text="0" FontSize="58" FontWeight="Black" HorizontalAlignment="Center" Foreground="#F7FAFC"/>
                                        <TextBlock Text="KM/H" Foreground="#FFC400" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Bottom" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource MiniCard}"><StackPanel><TextBlock Text="RPM" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="RpmText" Text="0" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="1" Style="{StaticResource MiniCard}" Margin="8,0"><StackPanel><TextBlock Text="MARCHA" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="GearText" Text="N" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="2" Style="{StaticResource MiniCard}"><StackPanel><TextBlock Text="CRUISE" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="CruiseText" Text="OFF" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="9,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="#FFC400" FontSize="30" Margin="0,0,12,0"/><StackPanel><TextBlock Text="TACÓGRAFO" FontSize="20" FontWeight="Bold"/><TextBlock Text="Jornada • Condução • Descanso" Foreground="#8FA1B2" FontSize="11"/></StackPanel></StackPanel>
                                    <Border Background="#07131E" BorderBrush="#1D3A4E" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,18,0,10">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HORA" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="TimeText" Text="--:--" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="STATUS" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="TachographStatusText" Text="AGUARDANDO" Foreground="#27E06F" FontSize="13" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DATA" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="DateText" Text="--/--/----" FontSize="13" FontWeight="Bold"/></StackPanel></Grid>
                                    </Border>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource MiniCard}"><TextBlock x:Name="DrivingText" Text="00:00:00" FontSize="18" FontWeight="Bold"/></Border>
                                        <Border Grid.Column="1" Style="{StaticResource MiniCard}" Margin="8,0"><TextBlock x:Name="RestText" Text="--:--" FontSize="18" FontWeight="Bold"/></Border>
                                        <Border Grid.Column="2" Style="{StaticResource MiniCard}"><TextBlock x:Name="DistanceText" Text="0 km" FontSize="18" FontWeight="Bold"/></Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="ODÔMETRO" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="OdometerText" Text="128.420 km" FontSize="17" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="8,0"><StackPanel><TextBlock Text="COMBUSTÍVEL" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="FuelText" Text="984 L" FontSize="17" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="8,0"><StackPanel><TextBlock Text="AUTONOMIA" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="RangeText" Text="2.755 km" FontSize="17" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="8,0"><StackPanel><TextBlock Text="CARGA ATUAL" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="CargoText" Text="Nenhuma carga" FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource StatCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="ETA" Foreground="#8FA1B2" FontSize="10"/><TextBlock x:Name="EtaText" Text="--:--" Foreground="#FFC400" FontSize="20" FontWeight="Black" Margin="0,3,0,0"/></StackPanel></Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="MEU BANCO" Foreground="#FFC400" FontSize="18" FontWeight="Bold"/><TextBlock Text="Seu dinheiro, na sua jornada" Foreground="#8FA1B2" FontSize="11"/><TextBlock Text="R$ 4.280,75" Foreground="#27E06F" FontSize="26" FontWeight="Black" Margin="0,16,0,0"/><Button Content="VER EXTRATO  ›" Style="{StaticResource ActionButton}" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0"><StackPanel><TextBlock Text="GARAGEM" FontSize="18" FontWeight="Bold"/><TextBlock Text="Caminhões e motoristas" Foreground="#8FA1B2" FontSize="11"/><TextBlock Text="Frota pessoal" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0"/><Button Content="ABRIR" Style="{StaticResource ActionButton}" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="MEU VEÍCULO" FontSize="18" FontWeight="Bold"/><TextBlock Text="Estado do caminhão" Foreground="#8FA1B2" FontSize="11"/><TextBlock Text="Diagnósticos e manutenção" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0"/><Button Content="ABRIR" Style="{StaticResource ActionButton}" Margin="0,12,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#07131E" BorderBrush="#182A38" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#27E06F" Margin="0,0,8,0"/><TextBlock Text="STATUS" Foreground="#27E06F" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FooterStatusText" Text="   Telemetria local  •  Aguardando ETS2" Foreground="#7C8F9F" FontSize="10"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="TRANSPOLI   v0.1.0" Foreground="#FFC400" FontSize="10" VerticalAlignment="Center"/></DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
